{
  // The only string table there is, and the only one M16 ships (ADR-0016).
  //
  // A second language is a copy of this file with the values translated -- **for a language the
  // overlay can draw**. The font atlas is Dear ImGui's default: Basic Latin and Latin-1
  // Supplement. French, German, Spanish and Italian would render from a file like this one;
  // Polish, Czech, Turkish, Greek, Russian and every CJK language would show blanks until
  // somebody bundles a font and configures glyph ranges. docs/DEFERRED.md records that with the
  // trigger.
  //
  // Keys are identifiers, not prose. They are also what a reader sees when an entry is missing,
  // so they are written to be legible in that state: `ui.undo` is a usable thing to find in a
  // button and `s17` is not. Every key here is named in
  // engine/tools/include/atlas/tools/text_keys.hpp, and `--text-check` resolves that list
  // against this file.
  //
  // Log messages are deliberately absent. A log line is a diagnostic for whoever reads the
  // build, and routing 157 of them through a table would make every integration case's grep
  // depend on a locale.
  "format": "atlas-strings",
  "version": 1,
  "locale": "en",

  "strings": {
    // undo and redo
    "ui.undo": "Undo",
    "ui.undo_with": "Undo {0}",
    "ui.redo": "Redo",
    "ui.redo_with": "Redo {0}",
    "ui.history.depth": "{0} undo, {1} redo",

    // values standing in for something absent or trivial
    "ui.value.none": "none",
    "ui.value.yes": "yes",
    "ui.value.no": "no",
    "ui.value.not_composed": "not composed yet",
    "ui.value.whole_texture": "whole texture",

    // inspector rows
    "ui.entity.id": "id",
    "ui.entity.parent": "parent",
    "ui.entity.children": "children",
    "ui.entity.local_rotation": "local rotation",
    "ui.entity.local_scale": "local scale",
    "ui.entity.world_translation": "world translation",
    "ui.entity.world_transform": "world transform",
    "ui.entity.sprite_texture": "sprite texture",
    "ui.entity.sprite_size": "sprite size",
    "ui.entity.sprite_tint": "sprite tint",
    "ui.entity.sprite_layer": "sprite layer",
    "ui.entity.sprite_visible": "sprite visible",
    "ui.entity.animator_clip": "animator clip",
    "ui.entity.pose_time": "pose time",
    "ui.entity.pose_offset": "pose offset",
    "ui.entity.pose_rotation": "pose rotation",
    "ui.entity.pose_scale": "pose scale",
    "ui.entity.pose_frame": "pose frame",
    "ui.entity.camera_zoom": "camera zoom",
    "ui.entity.camera_active": "camera active",

    // inspector widgets
    "ui.editor.local_position": "local position",
    "ui.editor.playing": "playing",
    "ui.editor.remove_animator": "remove animator",
    "ui.editor.speed": "speed",
    "ui.editor.start_ms": "start (ms)",
    "ui.editor.loop": "loop",
    "ui.editor.name_too_long": "name (too long to edit): {0}",

    // the scene panel
    "ui.scene.entity_count": "{0} entities",
    "ui.scene.unnamed_entity": "entity {0}",
    "ui.scene.no_selection": "No entity selected.",

    // loop modes, by position against scene::LoopMode
    "ui.loop.once": "once",
    "ui.loop.loop": "loop",
    "ui.loop.ping_pong": "ping-pong",

    // the log console. The records themselves are diagnostics and are not translated.
    "ui.log.severity": "severity",
    "ui.log.category": "category",
    "ui.log.follow": "follow",
    "ui.log.clear": "Clear",
    "ui.log.counts": "{0} shown, {1} hidden, {2} held of {3}",
    "ui.severity.trace": "trace",
    "ui.severity.debug": "debug",
    "ui.severity.info": "info",
    "ui.severity.warning": "warning",
    "ui.severity.error": "error",
    "ui.severity.fatal": "fatal",

    // simulation controls
    "ui.sim.resume": "Resume",
    "ui.sim.pause": "Pause",
    "ui.sim.step": "Step",
    "ui.sim.unbounded": "Unbounded",
    "ui.sim.display_mode": "display mode",
    "ui.sim.reset_view": "Reset view",
    "ui.sim.save": "Save",
