{
  // The sandbox's grandchild. A frame track and nothing else, so this clip changes which part
  // of a sheet is shown and leaves the entity exactly where its author put it.
  //
  // Two columns by two rows rather than four cells in a line, so the shipped application
  // exercises the row arithmetic in cell_uv and not only the tests. The grid a clip declares
  // is its own; nothing checks it against the sheet actually attached, and ADR-0013 records
  // that as a known hazard with the condition that would fix it.
  "format": "atlas-animation-clip",
  "version": 1,
  "name": "cycle",
  "duration_ms": 800,
  "grid": {"columns": 2, "rows": 2},
  "frames": [
    {"time_ms":   0, "cell": 0},
    {"time_ms": 200, "cell": 1},
    {"time_ms": 400, "cell": 2},
    {"time_ms": 600, "cell": 3}
  ]
}
