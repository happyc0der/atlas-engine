{
  // The sandbox's parent root. Four seconds, looping, and both tracks of the transform:
  // an ellipse in position and one whole revolution in rotation.
  //
  // These are offsets, not placements (ADR-0013). The parent is authored at the origin, so
  // dragging it through the inspector moves the whole orbit and this file keeps working.
  //
  // The rotation reaching exactly one turn is the point rather than decoration: every child
  // hangs off this entity, so one turn here turns nine quads, which is what exercises the
  // renderer's rotated path on an ordinary frame instead of only in a test.
  "format": "atlas-animation-clip",
  "version": 1,
  "name": "orbit",
  "duration_ms": 4000,
  "transform": [
    {"time_ms":    0, "x":  30.000, "y":   0.000, "rotation": 0.000000},
    {"time_ms":  500, "x":  21.213, "y":  12.728, "rotation": 0.785398},
    {"time_ms": 1000, "x":   0.000, "y":  18.000, "rotation": 1.570796},
    {"time_ms": 1500, "x": -21.213, "y":  12.728, "rotation": 2.356194},
    {"time_ms": 2000, "x": -30.000, "y":   0.000, "rotation": 3.141593},
    {"time_ms": 2500, "x": -21.213, "y": -12.728, "rotation": 3.926991},
    {"time_ms": 3000, "x":   0.000, "y": -18.000, "rotation": 4.712389},
    {"time_ms": 3500, "x":  21.213, "y": -12.728, "rotation": 5.497787},
    {"time_ms": 4000, "x":  30.000, "y":   0.000, "rotation": 6.283185}
  ]
}
