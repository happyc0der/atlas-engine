#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    uint _entryPointOutput [[color(0)]];
};

struct main0_in
{
    uint input_id [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]])
{
    main0_out out = {};
    out._entryPointOutput = in.input_id;
    return out;
}

