#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 _entryPointOutput [[color(0)]];
};

struct main0_in
{
    float2 input_uv [[user(locn0)]];
    float4 input_colour [[user(locn1)]];
};

fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> atlas_texture [[texture(0)]], sampler atlas_sampler [[sampler(0)]])
{
    main0_out out = {};
    out._entryPointOutput = atlas_texture.sample(atlas_sampler, in.input_uv) * in.input_colour;
    return out;
}

