# SPDX-License-Identifier: GPL-3.0-or-later
#
# Inherits the project configuration and relaxes one check for this directory only.
#
# misc-no-recursion fires on perft, which is recursive because its definition is: the legal
# move count to a depth is the sum of the counts one deeper. The check's concern is unbounded
# depth, and depth here is the argument, which every caller passes as a small constant; a
# loop with an explicit stack would be the same computation written to satisfy a check whose
# concern is already answered. Scoped here, following engine/scene/src.
InheritParentConfig: true
Checks: >
  -misc-no-recursion
