{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "atlas",
  "version-string": "0.0.1",
  "description": "Atlas engine platform",
  "homepage": "https://github.com/happyc0der/atlas",
  "license": "GPL-3.0-or-later",
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
  "dependencies": [
    "catch2",
    {
      "name": "sdl3",
      "default-features": true,
      "features": [
        "vulkan"
      ],
      "platform": "linux"
    },
    {
      "name": "sdl3",
      "default-features": true,
      "platform": "!linux"
    },
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "sdl3-binding",
        "sdlgpu3-binding"
      ]
    }
  ],
  "features": {
    "profile": {
      "description": "Tracy profiler client. Version must match the Tracy GUI in use.",
      "dependencies": [
        "tracy"
      ]
    }
  },
  "overrides": [
    {
      "name": "catch2",
      "version-semver": "3.15.3"
    },
    {
      "name": "sdl3",
      "version": "3.4.12"
    },
    {
      "name": "tracy",
      "version": "0.13.1"
    },
    {
      "name": "imgui",
      "version": "1.92.8"
    }
  ]
}
